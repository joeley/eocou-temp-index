---
import appIcon from '../assets/images/eocou/app-icon.png';
import taskBoard from '../assets/images/eocou/task-board.jpg';
import noteOverview from '../assets/images/eocou/note-overview.jpg';
import profileSync from '../assets/images/eocou/profile-sync.jpg';

const updatedAt = '2026-07-09';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>亦酷小记 - Eocou 个人开发记录</title>
    <meta
      name="description"
      content="亦酷小记用于记录 Eocou 这个个人效率工具的开发想法、功能整理和学习过程。"
    />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/png" href={appIcon.src} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="亦酷小记首页">
        <img src={appIcon.src} width="48" height="48" alt="" />
        <span>
          <strong>亦酷小记</strong>
          <small>Eocou personal notes</small>
        </span>
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Eocou 个人项目记录</p>
          <h1 id="hero-title">记录一个个人效率小工具的设计与开发</h1>
          <p class="lead">
            Eocou（亦酷）是站长在个人学习和日常整理过程中维护的小项目。这里用于展示项目思路、界面截图和开发记录，不提供商业服务。
          </p>
        </div>
        <figure class="hero-image">
          <img
            src={taskBoard.src}
            width={taskBoard.width}
            height={taskBoard.height}
            alt="Eocou 任务整理界面截图"
          />
          <figcaption>任务整理界面截图</figcaption>
        </figure>
      </section>

      <section class="section" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">关于这个页面</p>
          <h2 id="about-title">简单、静态、个人用途</h2>
        </div>
        <div class="plain-grid">
          <article>
            <h3>项目记录</h3>
            <p>整理任务、笔记、提醒和日期管理相关的开发想法，记录个人工具从想法到界面的演进。</p>
          </article>
          <article>
            <h3>学习沉淀</h3>
            <p>记录移动端界面、数据同步、本地优先和使用体验方面的个人实践，不发布新闻资讯。</p>
          </article>
          <article>
            <h3>作品说明</h3>
            <p>页面仅展示站长个人开发过程中的截图和说明，不设置注册登录、收款、广告或付费入口。</p>
          </article>
        </div>
      </section>

      <section class="section muted" aria-labelledby="screens-title">
        <div class="section-heading">
          <p class="eyebrow">界面片段</p>
          <h2 id="screens-title">一些正在整理的方向</h2>
        </div>
        <div class="screens">
          <figure>
            <img
              src={noteOverview.src}
              width={noteOverview.width}
              height={noteOverview.height}
              alt="Eocou 笔记整理界面截图"
            />
            <figcaption>笔记目录</figcaption>
          </figure>
          <figure>
            <img
              src={profileSync.src}
              width={profileSync.width}
              height={profileSync.height}
              alt="Eocou 账号与同步界面截图"
            />
            <figcaption>同步设置</figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© 2026 亦酷小记。</p>
      <p>最后更新：{updatedAt}</p>
      <a href="https://beian.miit.gov.cn/" rel="noopener noreferrer" target="_blank">
        ICP备案号待备案通过后填写
      </a>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f5;
    --panel: #ffffff;
    --ink: #1d241f;
    --muted: #5f6b63;
    --line: #dfe5de;
    --accent: #18705f;
    --accent-soft: #e5f3ee;
    --warm: #f3ead9;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.7;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .site-header,
  main,
  .site-footer {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    padding: 24px 0 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .brand img {
    border-radius: 12px;
    box-shadow: 0 10px 28px rgb(29 36 31 / 12%);
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.2rem;
  }

  .brand small {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 48px;
    align-items: center;
    min-height: 640px;
    padding: 44px 0 72px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 700;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 720px;
    margin-bottom: 22px;
    font-size: clamp(2.5rem, 8vw, 5.2rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 12px;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.15rem;
  }

  .lead {
    max-width: 640px;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .hero-image,
  .screens figure {
    margin: 0;
  }

  .hero-image {
    justify-self: center;
    width: min(100%, 360px);
  }

  .hero-image img,
  .screens img {
    border: 10px solid var(--panel);
    border-radius: 28px;
    box-shadow: 0 26px 70px rgb(29 36 31 / 16%);
  }

  figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .section {
    padding: 72px 0;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 30px;
  }

  .plain-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .plain-grid article {
    min-height: 180px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .plain-grid p {
    color: var(--muted);
  }

  .muted {
    width: auto;
    margin-right: calc((100vw - 100%) / -2);
    margin-left: calc((100vw - 100%) / -2);
    padding-right: max(16px, calc((100vw - 1120px) / 2));
    padding-left: max(16px, calc((100vw - 1120px) / 2));
    background: var(--warm);
  }

  .screens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 360px));
    gap: 28px;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    justify-content: center;
    padding: 30px 0 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--accent);
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 840px) {
    .hero,
    .plain-grid,
    .screens {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
      padding-top: 28px;
    }

    .screens {
      justify-items: center;
    }
  }
</style>
